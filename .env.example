PORT=3000
DATABASE_URL=postgresql://postgres:password@localhost:5432/flowdesk

# Invites (see .claude/specs/02-invite-member.md)
# Only emails on this domain can be invited
ORG_EMAIL_DOMAIN=saajha.org
# HMAC secret for invite tokens, at least 32 characters. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
INVITE_TOKEN_SECRET=hkjgkjehgerhgjerh
# How long an invite link stays valid
INVITE_EXPIRY_HOURS=72
# Frontend origin used to build the invite link
APP_BASE_URL=http://localhost:5173

# Email
# Default sender address
MAIL_FROM="Saajha <no-reply@saajha.org>"
# console (log emails to stdout, for local dev) or smtp
EMAIL_TRANSPORT=console
# Required when EMAIL_TRANSPORT=smtp
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
