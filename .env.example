PORT=3000
DATABASE_URL=postgresql://postgres:password@localhost:5432/flowdesk

# Invites (see .claude/specs/02-invite-member.md)
# Only emails on this domain can be invited
ORG_EMAIL_DOMAIN=saajha.org
# HMAC secret for invite tokens, at least 32 characters. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
INVITE_TOKEN_SECRET=hkjgkjehgerhgjerh
# How long an invite link stays valid
INVITE_EXPIRY_HOURS=72
# Frontend origin used to build the invite link
APP_BASE_URL=http://localhost:5173

# Email
# Default sender address
MAIL_FROM="Saajha <no-reply@saajha.org>"
# console (log emails to stdout, for local dev) or smtp
EMAIL_TRANSPORT=console
# Required when EMAIL_TRANSPORT=smtp
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=

# Auth (see .claude/specs/03-login.md)
# OAuth 2.0 Web client ID from Google Cloud Console; Google ID tokens must be issued for it
GOOGLE_CLIENT_ID=
# HMAC secret for access tokens, at least 32 characters, different from INVITE_TOKEN_SECRET
AUTH_JWT_SECRET=
# Access token lifetime (jsonwebtoken format, e.g. 8h, 30m)
AUTH_JWT_EXPIRES_IN=8h
# Only read by `npm run auth:bootstrap-admin`
# BOOTSTRAP_ADMIN_EMAIL=admin@saajha.org
# BOOTSTRAP_ADMIN_NAME=Admin
